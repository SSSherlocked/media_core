root = true

# The repository's line-ending rule, enforced at checkout by `.gitattributes`.
# Before that file existed this tree was mixed (475 CRLF / 654 LF), so saving a
# file could rewrite every one of its lines even when nothing else changed.
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2

[*.dart]
indent_size = 2
# Must match `formatter: page_width` in analysis_options.yaml and
# `dart.lineLength` in .vscode/settings.json. One number, three readers.
max_line_length = 120
trim_trailing_whitespace = true

[*.{yaml,yml,json}]
indent_size = 2
trim_trailing_whitespace = true

[*.{ps1,bat,cmd}]
# Windows scripts stay CRLF: PowerShell and cmd.exe handle a lone LF badly.
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false
